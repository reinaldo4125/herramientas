# Herramientas Automotrices Pro - .htaccess de Producción
# Configuración SEO, Redirecciones 301 y Rendimiento

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirigir www a sin www (HTTPS Forzado)
    RewriteCond %{HTTP_HOST} ^www\.herramientasautomotricespro\.com [NC]
    RewriteRule ^(.*)$ https://herramientasautomotricespro.com/$1 [L,R=301]

    # 2. Redirigir index.html a la raíz / (Evita problema "Página con redirección")
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ https://herramientasautomotricespro.com/$1 [R=301,L]

    # 3. Redirigir URLs antiguas de /home a la raíz /
    RewriteRule ^home/?$ https://herramientasautomotricespro.com/ [R=301,L]

    # 4. Redirecciones 301 para URLs detectadas en Google Search Console
    # URL antigua de seguridad en /home/ -> a su página raíz
    RewriteRule ^home/seguridad-herramientas\.html$ https://herramientasautomotricespro.com/seguridad-herramientas.html [R=301,L]
    
    # URL antigua de blog -> a la guía de escáneres
    RewriteRule ^blog/scanner-obd2-guia-completa\.html$ https://herramientasautomotricespro.com/scanners.html [R=301,L]
    
    # URL duplicada ancel-ad310 -> a la sección de escáneres
    RewriteRule ^ancel-ad310/?$ https://herramientasautomotricespro.com/scanners.html [R=301,L]
</IfModule>

# Compresión GZIP para máxima velocidad y Core Web Vitals
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché del navegador para imágenes, fuentes y CSS/JS
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
